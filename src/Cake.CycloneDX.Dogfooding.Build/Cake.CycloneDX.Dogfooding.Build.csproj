<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cake.Frosting" />
    <!-- Cake.Frosting requires a newer Cake.Core than the addin targets; override only for this build tool. -->
    <PackageReference Include="Cake.Core" VersionOverride="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cake.CycloneDX\Cake.CycloneDX.csproj" />
  </ItemGroup>

</Project>
